Prefix(:=<http://example.org/chain#>)
Ontology(<http://example.org/chain>
  Declaration(ObjectProperty(:parentOf)) Declaration(ObjectProperty(:childOf))
  Declaration(ObjectProperty(:ancestorOf)) Declaration(ObjectProperty(:relatedTo))
  Declaration(NamedIndividual(:a)) Declaration(NamedIndividual(:b))
  Declaration(NamedIndividual(:c)) Declaration(NamedIndividual(:d))
  Declaration(NamedIndividual(:e))
  TransitiveObjectProperty(:ancestorOf)
  SubObjectPropertyOf(:parentOf :ancestorOf)
  InverseObjectProperties(:parentOf :childOf)
  SymmetricObjectProperty(:relatedTo)
  SubObjectPropertyOf(ObjectPropertyChain(:childOf :ancestorOf) :relatedTo)
  ObjectPropertyAssertion(:parentOf :a :b)
  ObjectPropertyAssertion(:parentOf :b :c)
  ObjectPropertyAssertion(:parentOf :c :d)
  ObjectPropertyAssertion(:relatedTo :d :e)
)
