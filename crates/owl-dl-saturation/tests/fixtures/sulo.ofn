############################
#   Object Properties
############################

# Object Property: sulo:atTime (at time)

AnnotationAssertion(dcterms:alternative sulo:atTime "existsAt"@en)
AnnotationAssertion(rdfs:comment sulo:atTime "a relation between any thing and the time in which it occurs at."@en)
AnnotationAssertion(rdfs:label sulo:atTime "at time"@en)
InverseObjectProperties(sulo:atTime sulo:isTimeOf)
ObjectPropertyDomain(sulo:atTime owl:Thing)
ObjectPropertyRange(sulo:atTime sulo:Time)

# Object Property: sulo:contains (contains)

AnnotationAssertion(rdfs:comment sulo:contains "A binary relation where the subject entity includes the object entity within its spatial, temporal, structural, or conceptual extent."@en)
AnnotationAssertion(rdfs:label sulo:contains "contains"@en)
InverseObjectProperties(sulo:contains sulo:isIn)
TransitiveObjectProperty(sulo:contains)

# Object Property: sulo:hasDirectPart (has direct part)

AnnotationAssertion(rdfs:comment sulo:hasDirectPart "has direct part is a non-transitive parthood relation that can be used to specify cardinality constraints between a whole and its parts."@en)
AnnotationAssertion(rdfs:label sulo:hasDirectPart "has direct part")
SubObjectPropertyOf(sulo:hasDirectPart sulo:hasPart)
InverseObjectProperties(sulo:hasDirectPart sulo:isDirectPartOf)

# Object Property: sulo:hasFeature (has feature)

AnnotationAssertion(rdfs:comment sulo:hasFeature "has feature is a relation between a thing and an internal, contextual, or externally attributed characteristic."@en)
AnnotationAssertion(rdfs:label sulo:hasFeature "has feature"@en)
InverseObjectProperties(sulo:hasFeature sulo:isFeatureOf)
ObjectPropertyDomain(sulo:hasFeature ObjectUnionOf(sulo:Object sulo:Process))
ObjectPropertyRange(sulo:hasFeature sulo:Feature)

# Object Property: sulo:hasItem (has item)

AnnotationAssertion(rdfs:comment sulo:hasItem "has item is a relation between a collection and an item contained therein."@en)
AnnotationAssertion(rdfs:label sulo:hasItem "has item"@en)
InverseObjectProperties(sulo:hasItem sulo:isItemIn)
ObjectPropertyDomain(sulo:hasItem sulo:Collection)
ObjectPropertyRange(sulo:hasItem owl:Thing)

# Object Property: sulo:hasPart (has part)

AnnotationAssertion(rdfs:comment sulo:hasPart "has part is a transitive, reflexive and antisymmetric relation between a whole and itself or a whole and its part.")
AnnotationAssertion(rdfs:label sulo:hasPart "has part"@en)
SubObjectPropertyOf(sulo:hasPart sulo:contains)
InverseObjectProperties(sulo:hasPart sulo:isPartOf)
TransitiveObjectProperty(sulo:hasPart)
ReflexiveObjectProperty(sulo:hasPart)

# Object Property: sulo:hasParticipant (has participant)

AnnotationAssertion(rdfs:comment sulo:hasParticipant "has participant is a relation that describes the participation of a (non-process) thing in a process."@en)
AnnotationAssertion(rdfs:label sulo:hasParticipant "has participant"@en)
InverseObjectProperties(sulo:hasParticipant sulo:isParticipantIn)
ObjectPropertyDomain(sulo:hasParticipant sulo:Process)
ObjectPropertyRange(sulo:hasParticipant sulo:Object)

# Object Property: sulo:isDirectPartOf (is direct part of)

AnnotationAssertion(rdfs:comment sulo:isDirectPartOf "is direct part is a non-transitive parthood relation that can be used to specify cardinality constraints between a part and its whole."@en)
AnnotationAssertion(rdfs:label sulo:isDirectPartOf "is direct part of"@en)
SubObjectPropertyOf(sulo:isDirectPartOf sulo:isPartOf)

# Object Property: sulo:isFeatureOf (is feature of)

AnnotationAssertion(rdfs:comment sulo:isFeatureOf "is feature of is a relation between an internal, contextual, or externally attributed characteristic and some Thing."@en)
AnnotationAssertion(rdfs:label sulo:isFeatureOf "is feature of"@en)
ObjectPropertyDomain(sulo:isFeatureOf sulo:Feature)
ObjectPropertyRange(sulo:isFeatureOf ObjectUnionOf(sulo:Object sulo:Process))

# Object Property: sulo:isIn (is in)

AnnotationAssertion(rdfs:comment sulo:isIn "A binary relation where the object entity includes the subject entity within its spatial, temporal, structural, or conceptual extent."@en)
AnnotationAssertion(rdfs:label sulo:isIn "is in"@en)
SubObjectPropertyOf(sulo:isIn owl:topObjectProperty)
TransitiveObjectProperty(sulo:isIn)

# Object Property: sulo:isItemIn (is item in)

AnnotationAssertion(rdfs:comment sulo:isItemIn "has item is a relation between an item and the collection in which it contained."@en)
AnnotationAssertion(rdfs:label sulo:isItemIn "is item in"@en)
SubObjectPropertyOf(sulo:isItemIn owl:topObjectProperty)
ObjectPropertyDomain(sulo:isItemIn owl:Thing)
ObjectPropertyRange(sulo:isItemIn sulo:Collection)

# Object Property: sulo:isPartOf (is part of)

AnnotationAssertion(rdfs:comment sulo:isPartOf "is part of is a transitive, reflexive and antisymmetric relation between a part and itself or a part and a whole."@en)
AnnotationAssertion(rdfs:label sulo:isPartOf "is part of"@en)
SubObjectPropertyOf(sulo:isPartOf sulo:isIn)
TransitiveObjectProperty(sulo:isPartOf)
ReflexiveObjectProperty(sulo:isPartOf)

# Object Property: sulo:isParticipantIn (is participant in)

AnnotationAssertion(rdfs:comment sulo:isParticipantIn "is participant in is a relation to relate an object and the process in which it participates."@en)
AnnotationAssertion(rdfs:label sulo:isParticipantIn "is participant in"@en)
ObjectPropertyDomain(sulo:isParticipantIn sulo:Object)
ObjectPropertyRange(sulo:isParticipantIn sulo:Process)

# Object Property: sulo:isPrecededBy (is preceded by)

AnnotationAssertion(rdfs:comment sulo:isPrecededBy "A relation in which one process occurs after to another process."@en)
AnnotationAssertion(rdfs:label sulo:isPrecededBy "is preceded by"@en)
InverseObjectProperties(sulo:isPrecededBy sulo:precedes)
ObjectPropertyDomain(sulo:isPrecededBy sulo:Process)
ObjectPropertyRange(sulo:isPrecededBy sulo:Process)

# Object Property: sulo:isReferredToIn (is referred to in)

AnnotationAssertion(rdfs:comment sulo:isReferredToIn "is referred to in is relation between an object that is the subject of an information object."@en)
AnnotationAssertion(rdfs:label sulo:isReferredToIn "is referred to in"@en)
InverseObjectProperties(sulo:isReferredToIn sulo:refersTo)
ObjectPropertyDomain(sulo:isReferredToIn owl:Thing)
ObjectPropertyRange(sulo:isReferredToIn sulo:InformationObject)

# Object Property: sulo:isTimeOf (is time of)

AnnotationAssertion(rdfs:comment sulo:isTimeOf "a relation between a time and an object that occurs within it."@en)
AnnotationAssertion(rdfs:label sulo:isTimeOf "is time of")
ObjectPropertyDomain(sulo:isTimeOf sulo:Time)
ObjectPropertyRange(sulo:isTimeOf owl:Thing)

# Object Property: sulo:precedes (precedes)

AnnotationAssertion(rdfs:comment sulo:precedes "A relation in which one process occurs prior to another process."@en)
AnnotationAssertion(rdfs:label sulo:precedes "precedes")
ObjectPropertyDomain(sulo:precedes sulo:Process)
ObjectPropertyRange(sulo:precedes sulo:Process)

# Object Property: sulo:refersTo (refers to)

AnnotationAssertion(rdfs:comment sulo:refersTo "refers to is a binary relation between an information object and any other object that it mentions, describes, represents, encodes, or otherwise provides information about."@en)
AnnotationAssertion(rdfs:label sulo:refersTo "refers to"@en)
ObjectPropertyDomain(sulo:refersTo sulo:InformationObject)
ObjectPropertyRange(sulo:refersTo owl:Thing)


############################
#   Data Properties
############################

# Data Property: sulo:hasValue (has value)

AnnotationAssertion(rdfs:comment sulo:hasValue "has value is the (only) data type attribute to store the values of information objects."@en)
AnnotationAssertion(rdfs:label sulo:hasValue "has value"@en)
FunctionalDataProperty(sulo:hasValue)
DataPropertyDomain(sulo:hasValue sulo:InformationObject)



############################
#   Classes
############################

# Class: sulo:Capability (capability)

AnnotationAssertion(rdfs:comment sulo:Capability "A capability is a feature that describes what an entity is able to do, under some set of circumstances."@en)
AnnotationAssertion(rdfs:label sulo:Capability "capability")
AnnotationAssertion(skos:example sulo:Capability "the capability to fly, the capabilty to reduce the activation energy of a chemical reaction, the capability to reason"@en)
SubClassOf(sulo:Capability sulo:Feature)

# Class: sulo:Collection (collection)

AnnotationAssertion(rdfs:comment sulo:Collection "A collection is an information object for which there may be zero or more items."@en)
AnnotationAssertion(rdfs:label sulo:Collection "collection"@en)
AnnotationAssertion(skos:example sulo:Collection "a stamp collection, a murder of crows, the arm of a clinical trial"@en)
SubClassOf(sulo:Collection sulo:InformationObject)
SubClassOf(sulo:Collection ObjectAllValuesFrom(sulo:hasItem owl:Thing))
DisjointClasses(sulo:Collection sulo:Quantity)

# Class: sulo:Duration (duration)

AnnotationAssertion(rdfs:comment sulo:Duration "Duration is a temporal quantity that represents the extent or (non-negative) amount of time that elapses between two temporal points, typically the start and end of a time interval."@en)
AnnotationAssertion(rdfs:label sulo:Duration "duration"@en)
SubClassOf(sulo:Duration sulo:Time)
SubClassOf(sulo:Duration DataSomeValuesFrom(sulo:hasValue DatatypeRestriction(xsd:decimal xsd:minInclusive "0.0"^^xsd:decimal)))

# Class: sulo:EndTime (end time)

AnnotationAssertion(rdfs:comment sulo:EndTime "an end time is a time instant at the end of a process/time interval."@en)
AnnotationAssertion(rdfs:label sulo:EndTime "end time"@en)
SubClassOf(sulo:EndTime sulo:TimeInstant)
DisjointClasses(sulo:EndTime sulo:StartTime)

# Class: sulo:Feature (feature)

AnnotationAssertion(rdfs:comment sulo:Feature "A feature is any characteristic that stems from the intrisinc structure and/or context"@en)
AnnotationAssertion(rdfs:label sulo:Feature "feature"@en)
AnnotationAssertion(skos:example sulo:Feature "the capability to fly, a collection of cards, a measured height of 170cm."@en)
SubClassOf(sulo:Feature sulo:Object)
SubClassOf(sulo:Feature ObjectSomeValuesFrom(sulo:isFeatureOf ObjectUnionOf(sulo:Object sulo:Process)))
SubClassOf(sulo:Feature ObjectAllValuesFrom(sulo:hasPart sulo:Feature))
DisjointClasses(sulo:Feature sulo:SpatialObject)
DisjointUnion(sulo:Feature sulo:Capability sulo:InformationObject sulo:Quality sulo:Role)

# Class: sulo:InformationObject (information object)

AnnotationAssertion(rdfs:comment sulo:InformationObject "an information object is a feature that represents, is about, or encodes some information."@en)
AnnotationAssertion(rdfs:label sulo:InformationObject "information object"@en)
SubClassOf(sulo:InformationObject sulo:Feature)
SubClassOf(sulo:InformationObject ObjectAllValuesFrom(sulo:hasPart sulo:InformationObject))
SubClassOf(sulo:InformationObject DataAllValuesFrom(sulo:hasValue rdfs:Literal))

# Class: sulo:Object (object)

AnnotationAssertion(rdfs:comment sulo:Object "An object is an entity that maintains its identity through time, and does not have processes as its parts.")
AnnotationAssertion(rdfs:label sulo:Object "object"@en)
AnnotationAssertion(skos:example sulo:Object "a heart, the function to pump blood, the role of a doctor"@en)
SubClassOf(sulo:Object ObjectComplementOf(ObjectSomeValuesFrom(sulo:hasPart sulo:Process)))
SubClassOf(sulo:Object ObjectAllValuesFrom(sulo:hasPart sulo:Object))
DisjointClasses(sulo:Object sulo:Process)

# Class: sulo:Process (process)

AnnotationAssertion(rdfs:comment sulo:Process "a process is a entity that unfolds in time, has temporal parts, and has objects that participate in the process."@en)
AnnotationAssertion(rdfs:label sulo:Process "process"@en)
AnnotationAssertion(skos:example sulo:Process "the process of diagnosing a problem condition, the process of walking down the street, the process of teaching a class"@en)
SubClassOf(sulo:Process ObjectAllValuesFrom(sulo:hasPart sulo:Process))

# Class: sulo:Quality (quality)

AnnotationAssertion(rdfs:comment sulo:Quality "A quality is a feature that is intrinsically associated with its bearer (or its parts)."@en)
AnnotationAssertion(rdfs:comment sulo:Quality "the color of an apple, the smoothness of skin, the brightness of a star, the speed of an event"@en)
AnnotationAssertion(rdfs:label sulo:Quality "quality"@en)
SubClassOf(sulo:Quality sulo:Feature)

# Class: sulo:Quantity (quantity)

AnnotationAssertion(rdfs:comment sulo:Quantity "A quantity is an information object that represents the magnitude (and unit) of an object or process."@en)
AnnotationAssertion(rdfs:label sulo:Quantity "quantity"@en)
SubClassOf(sulo:Quantity sulo:InformationObject)
SubClassOf(sulo:Quantity ObjectSomeValuesFrom(sulo:hasPart sulo:Unit))

# Class: sulo:Role (role)

AnnotationAssertion(rdfs:comment sulo:Role "A role is a feature that describes a context-dependent behaviour."@en)
AnnotationAssertion(rdfs:label sulo:Role "role"@en)
AnnotationAssertion(skos:example sulo:Role "a teacher, a student, a catalyst, a substrate, a product, a patient"@en)
SubClassOf(sulo:Role sulo:Feature)

# Class: sulo:SpatialObject (spatial object)

AnnotationAssertion(rdfs:comment sulo:SpatialObject "A spatial object is an object that occupies space"@en)
AnnotationAssertion(rdfs:label sulo:SpatialObject "spatial object"@en)
AnnotationAssertion(skos:example sulo:SpatialObject "a mountain, a planet, a photon, the lining of the stomach, the cavity of the stomach, the space between mars and earth"@en)
SubClassOf(sulo:SpatialObject sulo:Object)
SubClassOf(sulo:SpatialObject ObjectAllValuesFrom(sulo:hasPart sulo:SpatialObject))

# Class: sulo:StartTime (start time)

AnnotationAssertion(rdfs:comment sulo:StartTime "a start time is a time instant at the beginning of a process/time interval."@en)
AnnotationAssertion(rdfs:label sulo:StartTime "start time"@en)
SubClassOf(sulo:StartTime sulo:TimeInstant)

# Class: sulo:Time (time)

AnnotationAssertion(rdfs:comment sulo:Time "time is a quantity pertaining to the duration of some interval of time or a particular instant of time (against some frame of reference)."@en)
AnnotationAssertion(rdfs:label sulo:Time "time"@en)
SubClassOf(sulo:Time sulo:Quantity)
DisjointClasses(sulo:Time sulo:Unit)
DisjointUnion(sulo:Time sulo:Duration sulo:TimeInstant sulo:TimeInterval)

# Class: sulo:TimeInstant (time instant)

AnnotationAssertion(rdfs:comment sulo:TimeInstant "time instant is a quantity of time a particular moment in time."@en)
AnnotationAssertion(rdfs:label sulo:TimeInstant "time instant"@en)
SubClassOf(sulo:TimeInstant sulo:Time)
SubClassOf(sulo:TimeInstant DataAllValuesFrom(sulo:hasValue DataUnionOf(xsd:dateTime xsd:dateTimeStamp)))

# Class: sulo:TimeInterval (time interval)

AnnotationAssertion(rdfs:comment sulo:TimeInterval "A time interval is a quantity for a continuous and bounded extent of time, characterized by a start time and an end time."@en)
AnnotationAssertion(rdfs:label sulo:TimeInterval "time interval")
SubClassOf(sulo:TimeInterval sulo:Time)
SubClassOf(sulo:TimeInterval ObjectSomeValuesFrom(sulo:hasDirectPart sulo:EndTime))
SubClassOf(sulo:TimeInterval ObjectSomeValuesFrom(sulo:hasDirectPart sulo:StartTime))
SubClassOf(sulo:TimeInterval ObjectSomeValuesFrom(sulo:hasPart sulo:Duration))
SubClassOf(sulo:TimeInterval ObjectSomeValuesFrom(sulo:hasPart sulo:Unit))

# Class: sulo:Unit (unit)

AnnotationAssertion(rdfs:comment sulo:Unit "a unit is a standardized quantity that is used as a reference for a particular quantity."@en)
AnnotationAssertion(rdfs:label sulo:Unit "unit")
SubClassOf(sulo:Unit sulo:Quantity)


DisjointClasses(sulo:Capability sulo:InformationObject sulo:Quality sulo:Role)
DisjointClasses(sulo:Duration sulo:TimeInstant sulo:TimeInterval)
SubObjectPropertyOf(ObjectPropertyChain(sulo:hasParticipant ObjectInverseOf(sulo:hasFeature)) sulo:hasParticipant)
)