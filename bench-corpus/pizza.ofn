############################
#   Classes
############################

# Class: :AiryTexture (airy texture)

AnnotationAssertion(rdfs:label :AiryTexture "airy texture"@en)
SubClassOf(:AiryTexture :DoughTexture)
DisjointClasses(:AiryTexture :DenseTexture)

# Class: :AssemblingThePizza (assembling the pizza)

AnnotationAssertion(rdfs:label :AssemblingThePizza "assembling the pizza"@en)
SubClassOf(:AssemblingThePizza <https://w3id.org/ontostart/pro/TransformationProcess>)
SubClassOf(:AssemblingThePizza ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(:BakerRole ObjectSomeValuesFrom(sulo:isFeatureOf :Person))))
SubClassOf(:AssemblingThePizza ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/EmergingRole> ObjectSomeValuesFrom(sulo:isFeatureOf :Pizza))))
SubClassOf(:AssemblingThePizza ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/PersistingRole> ObjectSomeValuesFrom(sulo:isFeatureOf owl:Thing))))
SubClassOf(:AssemblingThePizza ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/PersistingRole> ObjectSomeValuesFrom(sulo:isFeatureOf :Cheese))))
SubClassOf(:AssemblingThePizza ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/PersistingRole> ObjectSomeValuesFrom(sulo:isFeatureOf :PizzaDough))))
SubClassOf(:AssemblingThePizza ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/PersistingRole> ObjectSomeValuesFrom(sulo:isFeatureOf :PizzaSauce))))
SubClassOf(:AssemblingThePizza ObjectSomeValuesFrom(sulo:precedes :BakingThePizza))

# Class: :BakerRole (baker role)

AnnotationAssertion(rdfs:label :BakerRole "baker role"@en)
SubClassOf(:BakerRole <https://w3id.org/ontostart/pro/AgentRole>)

# Class: :BakersYeast (baker's yeast)

AnnotationAssertion(rdfs:label :BakersYeast "baker's yeast"@en)
SubClassOf(:BakersYeast :FoodMaterial)

# Class: :BakingDuration (baking duration)

AnnotationAssertion(rdfs:label :BakingDuration "baking duration"@en)
EquivalentClasses(:BakingDuration ObjectIntersectionOf(sulo:Duration DataSomeValuesFrom(sulo:hasValue DatatypeRestriction(xsd:decimal xsd:minInclusive "8.0"^^xsd:decimal xsd:maxInclusive "15.0"^^xsd:decimal))))
SubClassOf(:BakingDuration sulo:Duration)

# Class: :BakingEndTime (baking end time)

AnnotationAssertion(rdfs:label :BakingEndTime "baking end time"@en)
SubClassOf(:BakingEndTime sulo:EndTime)

# Class: :BakingStartTime (baking start time)

AnnotationAssertion(rdfs:label :BakingStartTime "baking start time"@en)
SubClassOf(:BakingStartTime sulo:StartTime)

# Class: :BakingThePizza (baking the pizza)

AnnotationAssertion(rdfs:label :BakingThePizza "baking the pizza"@en)
SubClassOf(:BakingThePizza <https://w3id.org/ontostart/pro/DevelopmentalProcess>)
SubClassOf(:BakingThePizza ObjectSomeValuesFrom(sulo:atTime :BakingEndTime))
SubClassOf(:BakingThePizza ObjectSomeValuesFrom(sulo:atTime :BakingStartTime))
SubClassOf(:BakingThePizza ObjectSomeValuesFrom(sulo:hasPart :CheeseMelting))
SubClassOf(:BakingThePizza ObjectSomeValuesFrom(sulo:hasPart :DoughBaking))
SubClassOf(:BakingThePizza ObjectSomeValuesFrom(sulo:precedes :SlicingThePizza))

# Class: :BoxedPizza (boxed pizza)

AnnotationAssertion(rdfs:label :BoxedPizza "boxed pizza"@en)
EquivalentClasses(:BoxedPizza ObjectIntersectionOf(:Pizza ObjectSomeValuesFrom(sulo:isIn :PizzaDeliveryBox)))
SubClassOf(:BoxedPizza :Pizza)

# Class: :BoxingThePizza (boxing the pizza)

AnnotationAssertion(rdfs:label :BoxingThePizza "boxing the pizza"@en)
SubClassOf(:BoxingThePizza sulo:Process)
SubClassOf(:BoxingThePizza ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/ContainedRole> ObjectSomeValuesFrom(sulo:isFeatureOf :Pizza))))
SubClassOf(:BoxingThePizza ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/ContainmentRole> ObjectSomeValuesFrom(sulo:isFeatureOf :PizzaDeliveryBox))))

# Class: :Cheese (cheese)

AnnotationAssertion(rdfs:comment :Cheese "A cheese is a food material derived from milk and produced in a wide range of flavors, textures, and forms by coagulation of the milk protein casein.")
AnnotationAssertion(rdfs:label :Cheese "cheese"@en)
SubClassOf(:Cheese :FoodMaterial)

# Class: :CheeseMelting (cheese melting)

AnnotationAssertion(rdfs:label :CheeseMelting "cheese melting"@en)
SubClassOf(:CheeseMelting <https://w3id.org/ontostart/pro/DevelopmentalProcess>)
SubClassOf(:CheeseMelting ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/DevelopmentRole> ObjectSomeValuesFrom(sulo:isFeatureOf :Cheese))))

# Class: :Cornicione (cornicione)

AnnotationAssertion(rdfs:comment :Cornicione "A cornicione is the outer edge of a pizza crust")
AnnotationAssertion(rdfs:label :Cornicione "cornicione"@en)
SubClassOf(:Cornicione :FoodMaterial)

# Class: :DeliveringThePizza (delivering the pizza)

AnnotationAssertion(rdfs:label :DeliveringThePizza "delivering the pizza"@en)
SubClassOf(:DeliveringThePizza sulo:Process)

# Class: :DeliveryDuration (delivery duration)

AnnotationAssertion(rdfs:label :DeliveryDuration "delivery duration"@en)
SubClassOf(:DeliveryDuration sulo:Duration)

# Class: :DeliveryTime (delivery time)

AnnotationAssertion(rdfs:label :DeliveryTime "delivery time"@en)
SubClassOf(:DeliveryTime sulo:TimeInstant)

# Class: :DenseTexture (dense texture)

AnnotationAssertion(rdfs:label :DenseTexture "dense texture"@en)
SubClassOf(:DenseTexture :DoughTexture)

# Class: :DoughBaking (dough baking)

AnnotationAssertion(rdfs:label :DoughBaking "dough baking"@en)
SubClassOf(:DoughBaking <https://w3id.org/ontostart/pro/DevelopmentalProcess>)
SubClassOf(:DoughBaking ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/DevelopmentRole> ObjectSomeValuesFrom(sulo:isFeatureOf :PizzaCrust))))
SubClassOf(:DoughBaking ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/DevelopmentRole> ObjectSomeValuesFrom(sulo:isFeatureOf :PizzaDough))))

# Class: :DoughTexture (dough texture)

AnnotationAssertion(rdfs:label :DoughTexture "dough texture"@en)
SubClassOf(:DoughTexture sulo:Quality)

# Class: :ExpressPizzaDelivery (express pizza delivery)

AnnotationAssertion(rdfs:label :ExpressPizzaDelivery "express pizza delivery"@en)
EquivalentClasses(:ExpressPizzaDelivery ObjectIntersectionOf(:DeliveringThePizza ObjectSomeValuesFrom(sulo:atTime ObjectIntersectionOf(:DeliveryDuration DataSomeValuesFrom(sulo:hasValue DatatypeRestriction(xsd:decimal xsd:maxInclusive "30.0"^^xsd:decimal))))))
SubClassOf(:ExpressPizzaDelivery :DeliveringThePizza)

# Class: :Flour (flour)

AnnotationAssertion(rdfs:label :Flour "flour"@en)
SubClassOf(:Flour :FoodMaterial)

# Class: :FoodMaterial (food material)

AnnotationAssertion(rdfs:comment :FoodMaterial "A food material is a spatial object that is intended for consumption as food.")
AnnotationAssertion(rdfs:label :FoodMaterial "food material"@en)
AnnotationAssertion(rdfs:label :FoodMaterial "food material")
SubClassOf(:FoodMaterial sulo:SpatialObject)

# Class: :FourCheesePizza (four cheese pizza)

AnnotationAssertion(rdfs:comment :FourCheesePizza "A Four Cheese Pizza is a pizza that contains exactly four different types of cheese as toppings.")
AnnotationAssertion(rdfs:label :FourCheesePizza "four cheese pizza"@en)
EquivalentClasses(:FourCheesePizza ObjectIntersectionOf(:Pizza ObjectExactCardinality(4 sulo:hasDirectPart :Cheese)))
SubClassOf(:FourCheesePizza :Pizza)

# Class: :Gorgonzola (gorgonzola)

AnnotationAssertion(rdfs:comment :Gorgonzola "Gorgonzola is a veined Italian blue cheese, made from unskimmed cow's milk.")
AnnotationAssertion(rdfs:label :Gorgonzola "gorgonzola"@en)
SubClassOf(:Gorgonzola :Cheese)

# Class: :HotPepper (hot pepper)

AnnotationAssertion(rdfs:label :HotPepper "hot pepper"@en)
SubClassOf(:HotPepper :FoodMaterial)
SubClassOf(:HotPepper ObjectSomeValuesFrom(sulo:hasFeature ObjectIntersectionOf(:SpicinessMeasurement ObjectSomeValuesFrom(sulo:hasPart :ScovilleHeatUnit) DataSomeValuesFrom(sulo:hasValue DatatypeRestriction(xsd:integer xsd:minInclusive "500000"^^xsd:integer)))))
DisjointClasses(:HotPepper :SpicySalami)

# Class: :HotPepperPizza (hot pepper pizza)

AnnotationAssertion(rdfs:label :HotPepperPizza "hot pepper pizza"@en)
EquivalentClasses(:HotPepperPizza ObjectIntersectionOf(:Pizza ObjectAllValuesFrom(sulo:hasDirectPart :HotPepper) ObjectExactCardinality(1 sulo:hasDirectPart :HotPepper) ObjectExactCardinality(1 sulo:hasDirectPart :PizzaSauce)))
SubClassOf(:HotPepperPizza :Pizza)

# Class: :MakingEndTime (making end time)

AnnotationAssertion(rdfs:label :MakingEndTime "making end time"@en)
SubClassOf(:MakingEndTime sulo:EndTime)

# Class: :MakingStartTime (making start time)

AnnotationAssertion(rdfs:label :MakingStartTime "making start time"@en)
SubClassOf(:MakingStartTime sulo:StartTime)

# Class: :MakingThePizzaDough (making the pizza dough)

AnnotationAssertion(rdfs:label :MakingThePizzaDough "making the pizza dough"@en)
SubClassOf(:MakingThePizzaDough <https://w3id.org/ontostart/pro/TransformationProcess>)
SubClassOf(:MakingThePizzaDough ObjectIntersectionOf(<https://w3id.org/ontostart/pro/TransformationProcess> ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(:BakerRole ObjectSomeValuesFrom(sulo:isFeatureOf :Person))) ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/ConsumedRole> ObjectSomeValuesFrom(sulo:isFeatureOf :BakersYeast))) ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/ConsumedRole> ObjectSomeValuesFrom(sulo:isFeatureOf :Flour))) ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/ConsumedRole> ObjectSomeValuesFrom(sulo:isFeatureOf :Salt))) ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/ConsumedRole> ObjectSomeValuesFrom(sulo:isFeatureOf :Sugar))) ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/ConsumedRole> ObjectSomeValuesFrom(sulo:isFeatureOf :Water))) ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/EmergingRole> ObjectSomeValuesFrom(sulo:isFeatureOf :PizzaDough)))))
SubClassOf(:MakingThePizzaDough ObjectSomeValuesFrom(sulo:atTime :MakingEndTime))
SubClassOf(:MakingThePizzaDough ObjectSomeValuesFrom(sulo:atTime :MakingStartTime))
SubClassOf(:MakingThePizzaDough ObjectSomeValuesFrom(sulo:precedes :ProofingTheDough))

# Class: :Mozzarella (mozzarella)

AnnotationAssertion(rdfs:comment :Mozzarella "Mozzarella is a traditionally southern Italian cheese made from Italian buffalo's milk by the pasta filata method.")
AnnotationAssertion(rdfs:label :Mozzarella "mozzarella"@en)
SubClassOf(:Mozzarella :Cheese)

# Class: :Order (order)

AnnotationAssertion(rdfs:label :Order "order"@en)
SubClassOf(:Order sulo:InformationObject)

# Class: :OrderIdentifier (order identifier)

AnnotationAssertion(rdfs:label :OrderIdentifier "order identifier"@en)
SubClassOf(:OrderIdentifier sulo:InformationObject)

# Class: :OrderReceivedTime (order received time)

AnnotationAssertion(rdfs:label :OrderReceivedTime "order received time"@en)
SubClassOf(:OrderReceivedTime sulo:TimeInstant)

# Class: :OrderingProcess (ordering process)

AnnotationAssertion(rdfs:label :OrderingProcess "ordering process"@en)
SubClassOf(:OrderingProcess sulo:Process)
SubClassOf(:OrderingProcess ObjectSomeValuesFrom(sulo:precedes :MakingThePizzaDough))

# Class: :Parmesan (parmesan)

AnnotationAssertion(rdfs:comment :Parmesan "Parmesan is a hard, granular cheese named after the producing areas near Parma, Italy.")
AnnotationAssertion(rdfs:label :Parmesan "parmesan"@en)
SubClassOf(:Parmesan :Cheese)

# Class: :PecorinoRomano (pecorino romano)

AnnotationAssertion(rdfs:comment :PecorinoRomano "Pecorino Romano is a hard, salty Italian cheese, often used for grating, made out of sheep's milk.")
AnnotationAssertion(rdfs:label :PecorinoRomano "pecorino romano"@en)
SubClassOf(:PecorinoRomano :Cheese)

# Class: :Person (person)

AnnotationAssertion(rdfs:label :Person "person"@en)
SubClassOf(:Person sulo:SpatialObject)

# Class: :Pizza (pizza)

AnnotationAssertion(rdfs:comment :Pizza "A pizza is a food material minimally consisting of a pizza crust (baked dough) and optionally topped with 
                    tomatoes or tomato sauce, cheese, and often various other ingredients (such as anchovies, mushrooms, onions, olives, 
                    vegetables, meat, etc.) baked at a high temperature.")
AnnotationAssertion(rdfs:label :Pizza "pizza"@en)
SubClassOf(:Pizza :FoodMaterial)
SubClassOf(:Pizza ObjectExactCardinality(1 sulo:hasDirectPart :PizzaCrust))

# Class: :PizzaCrust (pizza crust)

AnnotationAssertion(rdfs:comment :PizzaCrust "A pizza crust is a food material resulting from the cooking of a dough 
                    and forms the base of a pizza upon which sauce and toppings are added."@en)
AnnotationAssertion(rdfs:label :PizzaCrust "pizza crust"@en)
SubClassOf(:PizzaCrust :FoodMaterial)
SubClassOf(:PizzaCrust ObjectSomeValuesFrom(sulo:hasDirectPart :Cornicione))

# Class: :PizzaDeliveryBox (pizza delivery box)

AnnotationAssertion(rdfs:label :PizzaDeliveryBox "pizza delivery box"@en)
SubClassOf(:PizzaDeliveryBox sulo:SpatialObject)
SubClassOf(:PizzaDeliveryBox ObjectSomeValuesFrom(sulo:hasFeature <https://w3id.org/ontostart/pro/ContainmentRole>))

# Class: :PizzaDough (pizza dough)

AnnotationAssertion(rdfs:label :PizzaDough "pizza dough"@en)
SubClassOf(:PizzaDough :FoodMaterial)

# Class: :PizzaMakingProcess (pizza making process)

AnnotationAssertion(rdfs:label :PizzaMakingProcess "pizza making process"@en)
SubClassOf(:PizzaMakingProcess sulo:Process)
SubClassOf(:PizzaMakingProcess ObjectSomeValuesFrom(sulo:hasPart :SlicingThePizza))
SubClassOf(:PizzaMakingProcess ObjectSomeValuesFrom(sulo:hasPart ObjectIntersectionOf(:AssemblingThePizza ObjectSomeValuesFrom(sulo:precedes :BakingThePizza))))
SubClassOf(:PizzaMakingProcess ObjectSomeValuesFrom(sulo:hasPart ObjectIntersectionOf(:BakingThePizza ObjectSomeValuesFrom(sulo:precedes :SlicingThePizza))))
SubClassOf(:PizzaMakingProcess ObjectSomeValuesFrom(sulo:hasPart ObjectIntersectionOf(:MakingThePizzaDough ObjectSomeValuesFrom(sulo:precedes :ProofingTheDough))))
SubClassOf(:PizzaMakingProcess ObjectSomeValuesFrom(sulo:hasPart ObjectIntersectionOf(:ProofingTheDough ObjectSomeValuesFrom(sulo:precedes :AssemblingThePizza))))

# Class: :PizzaOven (pizza oven)

AnnotationAssertion(rdfs:label :PizzaOven "pizza oven"@en)
SubClassOf(:PizzaOven sulo:SpatialObject)
SubClassOf(:PizzaOven ObjectSomeValuesFrom(sulo:hasFeature <https://w3id.org/ontostart/pro/ContainmentRole>))

# Class: :PizzaRecipe (pizza recipe)

AnnotationAssertion(rdfs:label :PizzaRecipe "pizza recipe"@en)
EquivalentClasses(:PizzaRecipe ObjectIntersectionOf(sulo:InformationObject ObjectSomeValuesFrom(sulo:refersTo :PizzaMakingProcess)))
SubClassOf(:PizzaRecipe sulo:InformationObject)

# Class: :PizzaSauce (pizza sauce)

AnnotationAssertion(rdfs:label :PizzaSauce "pizza sauce"@en)
SubClassOf(:PizzaSauce :FoodMaterial)

# Class: :PizzaSlice (pizza slice)

AnnotationAssertion(rdfs:label :PizzaSlice "pizza slice"@en)
SubClassOf(:PizzaSlice :FoodMaterial)

# Class: :PlacingPizzaOnTable (placing pizza on table)

AnnotationAssertion(rdfs:label :PlacingPizzaOnTable "placing pizza on table"@en)
SubClassOf(:PlacingPizzaOnTable sulo:Process)
SubClassOf(:PlacingPizzaOnTable ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/OnTopPositionRole> ObjectSomeValuesFrom(sulo:isFeatureOf :Pizza))))
SubClassOf(:PlacingPizzaOnTable ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(<https://w3id.org/ontostart/pro/SurfacePositionRole> ObjectSomeValuesFrom(sulo:isFeatureOf :Table))))

# Class: :ProofedDoughRole (proofed dough role)

AnnotationAssertion(rdfs:label :ProofedDoughRole "proofed dough role"@en)
SubClassOf(:ProofedDoughRole sulo:Role)
DisjointClasses(:ProofedDoughRole :UnproofedDoughRole)

# Class: :ProofingTheDough (proofing the dough)

AnnotationAssertion(rdfs:label :ProofingTheDough "proofing the dough"@en)
SubClassOf(:ProofingTheDough <https://w3id.org/ontostart/pro/DevelopmentalProcess>)
SubClassOf(:ProofingTheDough ObjectIntersectionOf(ObjectSomeValuesFrom(sulo:hasPart ObjectIntersectionOf(:ProofingThePizzaDough_EndPhase ObjectSomeValuesFrom(sulo:isPrecededBy :ProofingThePizzaDough_StartPhase))) ObjectSomeValuesFrom(sulo:hasPart ObjectIntersectionOf(:ProofingThePizzaDough_StartPhase ObjectSomeValuesFrom(sulo:precedes :ProofingThePizzaDough_EndPhase)))))
SubClassOf(:ProofingTheDough ObjectSomeValuesFrom(sulo:precedes :AssemblingThePizza))

# Class: :ProofingThePizzaDough_EndPhase (proofed dough role)

AnnotationAssertion(rdfs:label :ProofingThePizzaDough_EndPhase "proofed dough role"@en)
SubClassOf(:ProofingThePizzaDough_EndPhase sulo:Process)
SubClassOf(:ProofingThePizzaDough_EndPhase ObjectIntersectionOf(ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(:AiryTexture ObjectSomeValuesFrom(sulo:isFeatureOf :PizzaDough))) ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(:ProofedDoughRole ObjectSomeValuesFrom(sulo:isFeatureOf :PizzaDough)))))

# Class: :ProofingThePizzaDough_StartPhase (proofed dough role)

AnnotationAssertion(rdfs:label :ProofingThePizzaDough_StartPhase "proofed dough role"@en)
SubClassOf(:ProofingThePizzaDough_StartPhase sulo:Process)
SubClassOf(:ProofingThePizzaDough_StartPhase ObjectIntersectionOf(ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(:DenseTexture ObjectSomeValuesFrom(sulo:isFeatureOf :PizzaDough))) ObjectSomeValuesFrom(sulo:hasParticipant ObjectIntersectionOf(:UnproofedDoughRole ObjectSomeValuesFrom(sulo:isFeatureOf :PizzaDough)))))

# Class: :Salt (salt)

AnnotationAssertion(rdfs:label :Salt "salt"@en)
SubClassOf(:Salt :FoodMaterial)

# Class: :ScovilleHeatUnit (Scoville heat unit)

AnnotationAssertion(rdfs:comment :ScovilleHeatUnit "A unit to measure the spiciness or \"heat\" of chili peppers and substances based on their concentration of capsaicinoids. 
                    The scale indicates how many times a chili extract must be diluted in sugar water before its heat is undetectable to tasters.")
AnnotationAssertion(rdfs:label :ScovilleHeatUnit "Scoville heat unit"@en)
SubClassOf(:ScovilleHeatUnit sulo:Unit)

