Prefix(:=<urn:mt#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<urn:mt>
  Declaration(ObjectProperty(:anc)) TransitiveObjectProperty(:anc)
  Declaration(ObjectProperty(:knows)) SymmetricObjectProperty(:knows)
  Declaration(ObjectProperty(:hasParent))
  Declaration(ObjectProperty(:hasChild))
  Declaration(ObjectProperty(:hasAncestor)) TransitiveObjectProperty(:hasAncestor)
  SubObjectPropertyOf(:hasParent :hasAncestor)
  InverseObjectProperties(:hasChild :hasParent)
  Declaration(ObjectProperty(:hv)) Declaration(Class(:C))
  Declaration(NamedIndividual(:t1)) Declaration(NamedIndividual(:t2)) Declaration(NamedIndividual(:t3))
  Declaration(NamedIndividual(:s1)) Declaration(NamedIndividual(:s2))
  Declaration(NamedIndividual(:mary)) Declaration(NamedIndividual(:alice)) Declaration(NamedIndividual(:john))
  Declaration(NamedIndividual(:e)) Declaration(NamedIndividual(:v)) Declaration(NamedIndividual(:g))
  ObjectPropertyAssertion(:anc :t1 :t2)
  ObjectPropertyAssertion(:anc :t2 :t3)
  ObjectPropertyAssertion(:knows :s1 :s2)
  ObjectPropertyAssertion(:hasChild :mary :alice)
  ObjectPropertyAssertion(:hasParent :mary :john)
  ClassAssertion(ObjectHasValue(:hv :v) :e)
  SubClassOf(:C ObjectHasValue(:hv :v))
  ClassAssertion(:C :g)
  Declaration(DataProperty(:age)) Declaration(DataProperty(:lifespan))
  SubDataPropertyOf(:age :lifespan)
  Declaration(NamedIndividual(:carol))
  DataPropertyAssertion(:age :carol "42"^^xsd:integer)
  Declaration(NamedIndividual(:bob)) Declaration(NamedIndividual(:robert))
  SameIndividual(:bob :robert)
  DataPropertyAssertion(:age :bob "7"^^xsd:integer)
)
