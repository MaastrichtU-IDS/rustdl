/target
**/*.rs.bk
Cargo.lock.bak

# Ontology corpus (fetched by xtask, not vendored).
# Match BOTH the directory and a bare `ontologies` symlink (no trailing
# slash) — a worktree-local symlink named `ontologies` once slipped past
# `/ontologies/` and got committed, and merging it deleted the real corpus.
/ontologies
/ontologies/

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code session state
# NOTE the trailing `/*`, not `/`: git cannot re-include a path whose PARENT DIRECTORY is
# excluded, so `.claude/` + `!.claude/skills/` silently keeps skills ignored. Excluding the
# CONTENTS instead leaves the directory eligible for the negation below.
.claude/*
# DO track skills: they are the measurement/review discipline this repo runs on, and a
# lesson that lives only on one machine gets re-learned the expensive way. Everything else
# under .claude/ (worktrees, session state, local settings) stays ignored.
!.claude/skills/

# Local environments
.venv/
.env

# Bench output
/target/criterion
/bench-results/

# Flamegraph output
flamegraph.svg
perf.data*
ontologies/external/

# stray root-level test artifacts (oracles / converted inputs)
/*.owx
/*-in.ofn

protege/src/main/resources/native/
protege/target/
