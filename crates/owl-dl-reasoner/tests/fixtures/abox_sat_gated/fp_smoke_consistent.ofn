Prefix(:=<http://example.org/fp-smoke#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

Ontology(<http://example.org/fp-smoke>

  Declaration(Class(:Male))
  Declaration(Class(:Female))
  Declaration(ObjectProperty(:hasSex))
  Declaration(ObjectProperty(:hasSexInv))
  Declaration(ObjectProperty(:knows))
  Declaration(NamedIndividual(:pat))
  Declaration(NamedIndividual(:maleFiller))
  Declaration(NamedIndividual(:friend))

  DisjointClasses(:Male :Female)
  FunctionalObjectProperty(:hasSex)
  InverseObjectProperties(:hasSex :hasSexInv)
  SubClassOf(:Male :Person)
  SubClassOf(:Female :Person)

  ClassAssertion(:Male :maleFiller)
  ObjectPropertyAssertion(:hasSex :pat :maleFiller)
  ObjectPropertyAssertion(:knows :pat :friend)
)
