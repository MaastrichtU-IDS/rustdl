Prefix(:=<http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(vin:=<http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(food:=<http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine>
Declaration(Class(vin:Riesling))
Declaration(Class(vin:Sancerre))
Declaration(Class(vin:SweetRiesling))
Declaration(Class(vin:WhiteNonSweetWine))
Declaration(Class(vin:WhiteWine))
Declaration(Class(vin:Wine))
Declaration(ObjectProperty(vin:hasColor))
Declaration(ObjectProperty(vin:hasSugar))
Declaration(ObjectProperty(vin:madeFromGrape))
Declaration(NamedIndividual(vin:Dry))
Declaration(NamedIndividual(vin:OffDry))
Declaration(NamedIndividual(vin:RieslingGrape))
Declaration(NamedIndividual(vin:SchlossVolradTrochenbierenausleseRiesling))
Declaration(NamedIndividual(vin:Sweet))
Declaration(NamedIndividual(vin:White))
EquivalentClasses(vin:Riesling ObjectIntersectionOf(vin:Wine ObjectHasValue(vin:madeFromGrape vin:RieslingGrape) ObjectMaxCardinality(1 vin:madeFromGrape)))
SubClassOf(vin:Riesling ObjectHasValue(vin:hasColor vin:White))
SubClassOf(vin:Sancerre ObjectHasValue(vin:hasSugar vin:OffDry))
EquivalentClasses(vin:SweetRiesling ObjectIntersectionOf(vin:Riesling ObjectHasValue(vin:hasSugar vin:Sweet)))
EquivalentClasses(vin:WhiteNonSweetWine ObjectIntersectionOf(vin:WhiteWine ObjectAllValuesFrom(vin:hasSugar ObjectOneOf(vin:Dry vin:OffDry))))
EquivalentClasses(vin:WhiteWine ObjectIntersectionOf(vin:Wine ObjectHasValue(vin:hasColor vin:White)))
ClassAssertion(vin:SweetRiesling vin:SchlossVolradTrochenbierenausleseRiesling)
DifferentIndividuals(vin:Dry vin:Sweet)
DifferentIndividuals(vin:OffDry vin:Sweet)
)
